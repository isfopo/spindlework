{
  "name": "tenet",
  "type": "module",
  "scripts": {
    "predev": "node -e \"const t=()=>import('spindlework/plugins').then(()=>process.exit(0)).catch(()=>setTimeout(t,200));t()\"",
    "dev": "vite --host",
    "deploy": "npm run build && wrangler deploy",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "check:type": "tsc --noEmit",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "spindlework": "*",
    "hono": "^4.13.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.35.0",
    "@cloudflare/vitest-pool-workers": "^0.16.3",
    "@cloudflare/workers-types": "^5.0.0",
    "@types/node": "^25.6.0",
    "typescript": "^7.0.2",
    "typescript-plugin-css-modules": "^5.2.0",
    "vite": "^6.4.2",
    "vitest": "^4.1.5",
    "wrangler": "^4.90.0"
  }
}
