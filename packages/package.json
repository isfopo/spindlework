{
  "name": "spindlework",
  "version": "0.0.8",
  "private": false,
  "type": "module",
  "license": "MIT",
  "description": "TypeScript metaframework: server-rendered JSX views, a typed SQL/schema DSL, and declarative client handlers.",
  "author": {
    "name": "Isaac Poole",
    "email": "isaacpoolemusic@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isfopo/spindlework.git"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "hono",
    "framework",
    "jsx",
    "tsx",
    "sql",
    "d1"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsdown --watch --sourcemap",
    "build": "tsdown",
    "test": "vitest run",
    "prepack": "tsdown"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fiber": {
      "types": "./dist/fiber/index.d.ts",
      "import": "./dist/fiber/index.js"
    },
    "./thread": {
      "types": "./dist/thread/index.d.ts",
      "import": "./dist/thread/index.js"
    },
    "./fabric": {
      "types": "./dist/fabric/index.d.ts",
      "import": "./dist/fabric/index.js"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "import": "./dist/plugins/index.js"
    }
  },
  "peerDependencies": {
    "hono": "^4.12.16",
    "vite": "^6.4.2",
    "wrangler": "^4.90.0"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "clean-css": "^5.3.3",
    "esbuild": "^0.28.1",
    "jsdom": "^30.1.0",
    "node-sql-parser": "^5.4.0",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.35.0",
    "@cloudflare/vitest-pool-workers": "^0.16.3",
    "@cloudflare/workers-types": "^5.0.0",
    "@types/clean-css": "^4.2.11",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "tsdown": "^0.22.14",
    "tsx": "^4.21.0",
    "typescript-plugin-css-modules": "^5.2.0",
    "vite": "^6.4.2",
    "vitest": "^4.1.5",
    "wrangler": "^4.90.0"
  }
}
