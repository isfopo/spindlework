{
  "name": "spindlework-workspace",
  "private": true,
  "workspaces": [
    "packages",
    "examples/*"
  ],
  "scripts": {
    "predev": "npm run build -w spindlework",
    "dev": "concurrently \"npm run dev -w spindlework\" \"npm run dev -w tenet\""
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "@parcel/watcher@2.6.0": true,
    "esbuild": true,
    "workerd": true
  },
  "overrides": {
    "vitest": {
      "vite": "^6.4.2"
    }
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
